<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="accessibility_description">Serviço de Multitarefas e Gestos para a Tela de Capa do Galaxy Z Flip</string>
    <string name="app_name">ZFlip Cover Mirror</string>
    <style name="Theme.ZFlipMirror" parent="android:Theme.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>