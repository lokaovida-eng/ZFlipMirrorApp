<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_zflip_logo"
        android:label="ZFlip Cover Mirror"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZFlipMirror">

        <!-- Samsung Galaxy Z Flip 5 / 6 / 7 Cover Display MultiStar Meta-Data -->
        <meta-data
            android:name="com.samsung.android.foldable.cover.display.support"
            android:value="true" />
        <meta-data
            android:name="com.samsung.android.activity.showOnCover"
            android:value="true" />

        <activity
            android:name="com.zflip.mirror.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ZFlipMirror"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">

            <meta-data
                android:name="com.samsung.android.foldable.cover.display.support"
                android:value="true" />
            <meta-data
                android:name="com.samsung.android.activity.showOnCover"
                android:value="true" />
            <meta-data
                android:name="com.samsung.android.multistar.cover.display.support"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
            </intent-filter>
        </activity>

        <service
            android:name="com.zflip.mirror.CoverMirrorService"
            android:exported="false" />
    </application>

</manifest>
